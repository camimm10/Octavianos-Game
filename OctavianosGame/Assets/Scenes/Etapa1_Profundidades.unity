--- !u!114 &1849642463
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1849642462}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 54d576229901fd548a8c1347238d311f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  talkDistance: 3.5
  autoStart: 1
  onlyOnce: 1
  objectiveBefore: "Ac\xE9rcate al pulpo que te est\xE1 mirando"
  objectiveAfter: 
  lines:
  - speaker: Brisa
    text: "\xA1Octavio! \xBFQu\xE9 haces aqu\xED? \xBFTe has perdido?"
    isPlayer: 0
    skinColor: {r: 0.15, g: 0.4, b: 0.95, a: 1}
  - speaker: Octavio
    text: "Eh\u2026 creo que s\xED. Estaba siguiendo un banco de peces y, cuando
      me di cuenta, ya no ve\xEDa las rocas de casa."
    isPlayer: 1
    skinColor: {r: 0.95, g: 0.85, b: 0.2, a: 1}
  - speaker: Brisa
    text: "\xA1Est\xE1s muy lejos! Estas aguas no son seguras. Dicen que por aqu\xED
      cerca est\xE1 el g\xE9iser DESTELLO."
    isPlayer: 0
    skinColor: {r: 0.9, g: 0.15, b: 0.15, a: 1}
  - speaker: Octavio
    text: "\xBFEl g\xE9iser de las historias? \xBFEl que se traga todo lo que se
      acerca?"
    isPlayer: 1
    skinColor: {r: 0.15, g: 0.8, b: 0.3, a: 1}
  - speaker: Brisa
    text: "Ese mismo. Tus padres te lo han dicho mil veces\u2026 Venga, s\xEDgueme.
      Te llevo de vuelta a casa."
    isPlayer: 0
    skinColor: {r: 0.15, g: 0.4, b: 0.95, a: 1}
  - speaker: Octavio
    text: "Vale, vale\u2026 \xA1Voy detr\xE1s de ti!"
    isPlayer: 1
    skinColor: {r: 0.15, g: 0.8, b: 0.3, a: 1}
  guideAfter: {fileID: 1849642464}
  onFinished:
    m_PersistentCalls:
      m_Calls: []
